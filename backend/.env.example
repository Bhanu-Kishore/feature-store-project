# Optional overrides for running the backend outside Docker.
# Copy to .env and adjust values; never commit real secrets.

# Comma-separated list of allowed browser origins (use * only for demos).
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# Directory containing the exported MLflow model (MLmodel + model.skops).
MODEL_PATH=model

# Alternative: load directly from an MLflow URI, e.g. runs:/<run_id>/model
# MLFLOW_MODEL_URI=

# Feast repository root (contains feature_store.yaml).
FEAST_REPO_PATH=.
